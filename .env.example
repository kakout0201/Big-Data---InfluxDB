INFLUXDB_URL=https://localhost:8181
INFLUXDB_DATABASE=server_monitoring
INFLUXDB_TOKEN=your_influxdb3_token_here

# Weather database used by the Python scripts and the Grafana datasource (default: weather).
# INFLUXDB_DATABASE above is left over from the Phase 1 demo and is not used by the weather code.
WEATHER_INFLUXDB_DATABASE=weather

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here
